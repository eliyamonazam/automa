# Copy to automa.toml and adjust. This file must NOT contain secrets:
# the API key goes in .env as AUTOMA_API_KEY (a key here is rejected).

base_url = "https://openrouter.ai/api/v1"
workspace = "workspace"

# Roles request a tier; this maps each tier to a concrete model name.
[tiers]
small = "example/small-model"
medium = "example/medium-model"
large = "example/large-model"

# USD per one million tokens. Every model used in [tiers] must have a price.
[prices."example/small-model"]
input_per_mtok = 0.10
output_per_mtok = 0.40

[prices."example/medium-model"]
input_per_mtok = 1.00
output_per_mtok = 4.00

[prices."example/large-model"]
input_per_mtok = 5.00
output_per_mtok = 20.00

# Hard caps in USD. Reaching a cap stops the run; per_call must not exceed the others.
[limits]
project_usd = 5.0
daily_usd = 2.0
per_call_usd = 0.25

# Where run_command runs. "local" (default): on this machine, with your privileges,
# NOT isolated. "docker": each call in a fresh container with no network, read-only
# root filesystem, no capabilities, non-root user, only the project's files/ mounted.
# With "docker", automa run / automa bench run stop before any work if Docker does not
# answer (nothing ever falls back to the host). The image must already be pulled.
[sandbox]
mode = "local"
# mode = "docker"
# image = "python:3.12-slim"
# docker = "docker"      # client: a name on PATH or an absolute path
# memory_mb = 512        # 16..8192
# cpus = 1.0             # >0..8
# pids_limit = 128       # 8..4096

# How automa run schedules tasks. max_parallel: independent tasks (all dependencies
# passed) driven at the same time, 1..8; 1 = one after another (default).
# `automa run <id> --parallel N` overrides it for one run. Spending is still capped
# by [limits] for all tasks together. Parallel tasks share the project's files/, and
# concurrent writes to the same path are NOT prevented yet.
[orchestrator]
max_parallel = 1
