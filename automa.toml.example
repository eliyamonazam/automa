# Copy to automa.toml and adjust. This file must NOT contain secrets:
# the API key goes in .env as AUTOMA_API_KEY (a key here is rejected).

base_url = "https://openrouter.ai/api/v1"
workspace = "workspace"

# Roles request a tier; this maps each tier to a concrete model name.
[tiers]
small = "example/small-model"
medium = "example/medium-model"
large = "example/large-model"

# USD per one million tokens. Every model used in [tiers] must have a price.
[prices."example/small-model"]
input_per_mtok = 0.10
output_per_mtok = 0.40

[prices."example/medium-model"]
input_per_mtok = 1.00
output_per_mtok = 4.00

[prices."example/large-model"]
input_per_mtok = 5.00
output_per_mtok = 20.00

# Model catalog (optional, D94): models with their family (maker), capabilities
# (text, code, vision, image_out) and price in USD per one million tokens. A catalog
# entry is priced, so a tier may name it instead of an entry in [prices]; a model must
# not be priced in both places. Family and capabilities are data for model selection
# (cross-family verifier, per-role models); they never grant a tool or budget.
# [models."example/vision-model"]
# family = "example"
# capabilities = ["text", "code", "vision"]
# input_per_mtok = 2.00
# output_per_mtok = 8.00
# An image model (for the generate_image tool, D100) also needs per_image_usd, the
# price of one generated image; generate_image refuses an image model without it:
# [models."example/image-model"]
# family = "example"
# capabilities = ["image_out"]
# input_per_mtok = 0
# output_per_mtok = 0
# per_image_usd = 0.04
# A chat-based image model (answers on /chat/completions with a base64 image, D103)
# is priced by its token prices instead: image_api = "chat" plus image_max_tokens,
# the output-token cap of one image call. Its worst case per image is
# (1200 input + image_max_tokens output) tokens at those prices (per_image_usd, if
# also set, is a floor); `automa models` shows it.
# [models."example/chat-image-model"]
# family = "google"
# capabilities = ["text", "image_out"]
# input_per_mtok = 0.30
# output_per_mtok = 30.00
# image_api = "chat"
# image_max_tokens = 4000
# A Google image model on a gateway that serves it only natively (1xAi, D115):
# image_api = "gemini" posts to {root}/gemini/v1beta/models/{model}:generateContent
# (root = base_url without /v1); priced per token like "chat".
# [models."gemini-3.1-flash-image"]
# family = "google"
# capabilities = ["text", "image_out"]
# input_per_mtok = 0.501548
# output_per_mtok = 60.030961
# image_api = "gemini"
# image_max_tokens = 3000
# List the catalog with: automa models [--capability vision] [--family openai]
# Turn a 1xAi price list (id, input and output toman per 1K tokens) into entries to
# review and paste here (prints only, rounds prices up; D95):
#   automa models import --format 1xai prices.txt --rate 323000

# Cross-family verifier (optional, D96): the Verifier's model-based evaluation uses the
# first model below whose catalog family differs from the family of the model that did
# the work (e.g. a Claude worker is judged by a GPT or Gemini model). If the worker's
# family is unknown or no listed model is from another family, the verifier's tier
# model is used as before (event verifier.evaluator says why). Every model listed must
# be in the [models] catalog with the "text" capability; calls are capped as usual.
# [verifier]
# prefer_other_family = true
# models = ["openai/gpt-5.5", "google/gemini-3-pro"]

# Image generation (optional, D101): the built-in "designer" role may call
# generate_image with this catalogued image model (needs "image_out" and
# per_image_usd, or image_api = "chat" with image_max_tokens; its worst case per
# image at most [limits] per_call_usd). Every image is authorized and
# recorded by the BudgetGuard like any model call. Unset = off: the Executive is not
# offered the designer role, and a designer task stops the run before any call.
# max_per_task: images one task attempt may generate (1..20).
# [images]
# model = "example/image-model"
# max_per_task = 4

# Optional: show a toman equivalent next to dollar estimates (display only; never
# changes a price, a cap or the budget guard). Example: the 1xAi rate.
# [display]
# toman_per_usd = 323000
# Web UI language ("fa" or "en") and the time zone its times are shown in.
# language = "fa"
# timezone = "Asia/Tehran"

# Hard caps in USD. Reaching a cap stops the run; per_call must not exceed the others.
[limits]
project_usd = 5.0
daily_usd = 2.0
per_call_usd = 0.25
# Not a cap: automa run asks "Continue?" before spending when the upper end of the
# cost range is above this (0 = always ask; --yes starts without asking).
confirm_above_usd = 0.3
# Spending brake per task (an extra stop, never looser than the caps above): a task
# that has cost more than max(task_brake_factor x the high end of its estimated
# range, task_brake_min_usd) pauses the run between two model calls. Allow one more
# step of the same size with: automa brake continue <project> <task>
task_brake_min_usd = 0.15
task_brake_factor = 3.0

# Where run_command runs. "local" (default): on this machine, with your privileges,
# NOT isolated. "docker": each call in a fresh container with no network, read-only
# root filesystem, no capabilities, non-root user, only the project's files/ mounted.
# With "docker", automa run / automa bench run stop before any work if Docker does not
# answer (nothing ever falls back to the host). The image must already be pulled.
[sandbox]
mode = "local"
# mode = "docker"
# image = "python:3.12-slim"
# docker = "docker"      # client: a name on PATH or an absolute path
# memory_mb = 512        # 16..8192
# cpus = 1.0             # >0..8
# pids_limit = 128       # 8..4096

# How automa run schedules tasks. max_parallel: independent tasks (all dependencies
# passed) driven at the same time, 1..8; 1 = one after another (default).
# `automa run <id> --parallel N` overrides it for one run. Spending is still capped
# by [limits] for all tasks together. Parallel tasks share the project's files/:
# tasks whose checks name the same path run one after the other, and a file written
# by one running task cannot be written by another (write_file/delete_file only;
# files written by run_command are NOT checked).
[orchestrator]
max_parallel = 1

# Extra skills for built-in roles (names of folders in <workspace>/skills/ or built-in
# skills). Text only: a skill adds instructions to the role's system prompt and never
# changes its tools, risk level or budget. Each skill's text is sent with every step,
# so it adds input cost. At most 8 skills per role.
# [roles.writer]
# skills = ["house-style"]
#
# Per-role models (M11, D97): the role's own model ladder, weakest first. A task's tier
# picks the entry at that tier's position among the configured [tiers] (small, medium,
# large; higher tiers than the list is long use the last entry), so escalation still
# climbs. Every model must be in [models] with a price, `text` and each capability
# listed in `capabilities`. Calls still go through the BudgetGuard with that model's
# price. The data router does not route a role that has its own models (yet).
# [roles.developer]
# models = ["deepseek/deepseek-v4", "anthropic/claude-sonnet-5-5"]
# capabilities = ["code"]

# Memory (automa memory list|add|forget). in_prompts: automa new/run add the relevant
# memory (your preferences, this project's memory, lessons) to the system prompts as
# data, never as instructions: it grants no tool, risk level or budget. It adds input
# cost to every call (at most ~12k characters). `--no-memory` turns it off for one
# command, `--memory` on. automa bench run never uses memory.
[memory]
in_prompts = true

# Data router (M8, D58): picks a task's starting tier from the quality log
# (automa quality). A tier qualifies for a role when its model has at least
# min_attempts judged attempts with a pass rate of at least min_pass_rate. The router
# moves to a qualified tier only if it is not more expensive than the requested one
# (or if the requested tier is proven weak). It never changes the budget caps; every
# call is still checked by the BudgetGuard. Not yet used by automa run (next item).
[router]
enabled = false
min_attempts = 5
min_pass_rate = 0.8
# With too little data (no eligible tier has min_attempts judged attempts), let a
# small-tier model call pick a task type's starting model among the role's tier
# models that are not more expensive than the requested one (D99). One guarded
# call per (role, requested tier) per run; any invalid reply keeps the default.
# Needs a small tier and is only active while the router is.
selector = false

# Transient gateway failures (timeouts, network errors, 408/409/425/429/5xx) are
# retried; each retry is a new call the BudgetGuard must authorize. 402 (no
# balance), 401 (bad key) and other client errors are never retried. A request
# that timed out after being sent is charged at its worst case (it may have been
# billed). max_retries = 0 turns retrying off.
[provider]
max_retries = 3
retry_delays_s = [3.0, 10.0, 30.0]
timeout_s = 180.0

# Plain web reads. Off by default: every fetch_url call needs approval.
# With auto_approve_reads = true, fetch_url runs without asking ONLY for URLs that
# cannot plausibly carry project data out: https, default port, a normal host name,
# no query string, a short plain path. Everything else still asks. Every automatic
# read is logged (tool.auto_approved). Sending/publishing tools always ask.
[web]
auto_approve_reads = false
max_auto_reads_per_task = 20

# Unusual-spending warning (advisory only; never stops a run or changes a cap).
# A call is flagged only when it costs more than anomaly_factor times the usual
# cost of the same role and model AND at least anomaly_min_usd.
# [finance]
# anomaly_factor = 5.0
# anomaly_min_usd = 0.05
